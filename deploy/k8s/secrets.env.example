# The app's credentials. Everything else is set in deployment.yaml.
# Copy to secrets.env (gitignored), fill in, then:
#   kubectl -n campaign create secret generic campaign-secrets --from-env-file=deploy/k8s/secrets.env
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_SECRET=
# openssl rand -hex 32. Changing it signs everyone out.
CAMPAIGN_SESSION_SECRET=
